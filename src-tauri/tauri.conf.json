{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dushan Deck",
  "version": "0.1.0",
  "identifier": "com.dushan.deck",
  "build": {
    "beforeDevCommand": "node scripts/deck.mjs web",
    "beforeBuildCommand": "node scripts/deck.mjs frontend",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../Temp/build/frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "devCsp": "default-src \u0027self\u0027; script-src \u0027self\u0027 \u0027unsafe-inline\u0027; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420 http://127.0.0.1:1420; img-src \u0027self\u0027 data:; object-src \u0027none\u0027; frame-src \u0027none\u0027; base-uri \u0027none\u0027; form-action \u0027none\u0027",
      "csp": "default-src \u0027self\u0027; script-src \u0027self\u0027; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; connect-src ipc: http://ipc.localhost; img-src \u0027self\u0027 data:; object-src \u0027none\u0027; frame-src \u0027none\u0027; base-uri \u0027none\u0027; form-action \u0027none\u0027",
      "capabilities": [
        {
          "identifier": "desktop",
          "windows": ["main", "float"],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "core:window:allow-close",
            "core:window:allow-is-visible"
          ]
        },
        {
          "identifier": "float-window-controls",
          "windows": ["float"],
          "permissions": [
            "core:window:allow-start-dragging",
            "core:window:allow-start-resize-dragging"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../Temp/build/icons/icon.ico", "../Temp/build/icons/icon.png"]
  }
}
